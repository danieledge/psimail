// The toolbar, laid out as the built-in Email program has it: the name
// (a tap shows the open programs, as in Word), New, Reply (both pop up a
// choice: Reply, Reply to all, Forward), Check mail, and Delete (in a list)
// or Close (reading a message: back to the list), then the clock. The
// pictures come from PsiMail.mbm (CPmAppUi::ConstructL puts them on).
// (1.14) Three of it, chosen by the screen at start (CPmAppUi::ToolBarL):
//   r_pm_toolbar        240 lines (the 5mx): buttons of the 5mx's 37 pixels
//   r_pm_toolbar_tall   480 lines (Series 7, Psion's own netBook image):
//                       the netBook's 50-pixel buttons, as Word's and Agenda's
//   r_pm_toolbar_coda   480 lines on Coda (Z:\System\Libs\PsiBattHook.bin,
//                       core psitbar.h): the same, with Coda's battery
//                       (0x7044), its toolbar extras (the charge, free memory,
//                       brightness: PsiBatt, 0x7042) and Coda's clock (0x7043)
//                       at the foot, as in every Coda program (the stretching
//                       spacer above them: the box of CPmConnPanel sits there)
// The name is a file name label, as Psion's programs have it (bold, in its
// box; Coda draws that box in the theme's colours), with "PsiMail" set as
// the program's document name. The first is EIK_APP_INFO's: the others take
// its place when the screen is tall.
RESOURCE TOOLBAR r_pm_toolbar
	{
	breadth=KEikStdToolBarWidth;
	controls=
		{
		TBAR_CTRL
			{
			type=EEikCtFileNameLabel;
			id=EPmCmdFileName;
			flags=EEikToolBarCtrlHasSetMinLength;
			length=KEikStdFileNameLabelHeight;
			},
		TBAR_CTRL
			{
			type=EEikCtMenuButton; id=EPmCmdNewPopup;
			flags=EEikToolBarCtrlHasSetMinLength; length=KEikStdToolBarButtonHeight;
			control=MNBUT { popout=r_pm_new_popup; layout=EEikCmdButTextRightPictureLeft|EEikCmdButDenseFont|EEikCmdButExcessToText; txt="New"; };
			},
		TBAR_CTRL
			{
			type=EEikCtMenuButton; id=EPmCmdReplyPopup;
			flags=EEikToolBarCtrlHasSetMinLength; length=KEikStdToolBarButtonHeight;
			control=MNBUT { popout=r_pm_reply_popup; layout=EEikCmdButTextRightPictureLeft|EEikCmdButDenseFont|EEikCmdButExcessToText; txt="Reply"; };
			},
		TBAR_BUTTON { id=EPmCmdSendRecv; layout=EEikCmdButTextRightPictureLeft|EEikCmdButDenseFont|EEikCmdButExcessToText; txt="Check\nmail"; flags=EEikToolBarCtrlHasSetMinLength; length=KEikStdToolBarButtonHeight; },
		TBAR_BUTTON { id=EPmCmdTool4; layout=EEikCmdButTextRightPictureLeft|EEikCmdButDenseFont|EEikCmdButExcessToText; txt="Delete"; flags=EEikToolBarCtrlHasSetMinLength; length=KEikStdToolBarButtonHeight; },
		TBAR_CTRL
			{
			type=EEikCtSpacer;
			flags=EEikToolBarCtrlHasSetMinLength|EEikToolBarCtrlIsStretchable;
			length=0;
			control=SPACER;
			},
		TBAR_CTRL
			{
			type=EEikCtClock;
			control=CLOCK { digitalresourceid=R_EIK_DIGITAL_CLOCK; analogresourceid=R_EIK_ANALOG_CLOCK; };
			},
		TBAR_CTRL
			{
			type=EEikCtSpacer;
			flags=EEikToolBarCtrlHasSetMinLength;
			length=KEikStdGapBelowClock;
			control=SPACER;
			}
		};
	}

